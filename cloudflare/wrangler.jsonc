{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nuvo-vsim-v5-shadow",
  "main": "entry.js",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true }
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "triggers": { "crons": ["* 13-22 * * MON-FRI", "*/5 * * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNT_COORDINATOR", "class_name": "VsimAccountCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VsimAccountCoordinator"] }
  ],
  "workflows": [
    {
      "binding": "SHADOW_CYCLE_WORKFLOW",
      "name": "nuvo-vsim-stage2-shadow-cycle",
      "class_name": "ShadowCycleWorkflow"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nuvo-vsim-v5-shadow",
      "database_id": "20eb40a8-c162-43b8-b480-0d28042501de",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "EVIDENCE", "bucket_name": "nuvo-vsim-v5-evidence-shadow" }
  ],
  "ai": { "binding": "AI" },
  "queues": {
    "producers": [
      { "binding": "TELEGRAM_JOBS", "queue": "nuvo-vsim-telegram-jobs" }
    ],
    "consumers": [
      {
        "queue": "nuvo-vsim-telegram-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "nuvo-vsim-telegram-dead-letter",
        "max_concurrency": 1
      }
    ]
  },
  "services": [
    { "binding": "MARKET", "service": "master", "environment": "production" }
  ],
  "vars": {
    "NUVO_ENVIRONMENT": "shadow",
    "NUVO_AUTHORITY_LEVEL": "2",
    "NUVO_BROKER_MODE": "READ_ONLY",
    "NUVO_BROKER_EXECUTION_MODE": "SHADOW_ONLY",
    "NUVO_E3_SPINE_TAB": "ON",
    "NUVO_LANE_1_SPY_ARMED": "OFF",
    "NUVO_LANE_1_PRINCIPAL_FLATTEN": "OFF",
    "NUVO_LANE_1_DISCORD_SERVER": "NUVO VSIM",
    "NUVO_LANE_1_DISCORD_CHANNEL": "test",
    "NUVO_ALLOWED_STRUCTURES": "CSP,SHARES,COVERED_CALL",
    "NUVO_SYMBOLS": "SPY,QQQ,IWM",
    "NUVO_FUND_SYMBOLS": "SPY,QQQ,IWM",
    "NUVO_DTE_TARGETS": "14,30,45",
    "NUVO_CC_DTE_TARGETS": "7,14,21",
    "NUVO_MAX_CHAIN_AGE_MS": "120000",
    "NUVO_MAX_QUOTE_AGE_MS": "60000",
    "NUVO_MARKET_SOURCE": "SCHWAB_MARKET_DATA",
    "NUVO_UNDERLYING_SOURCE": "SCHWAB_MARKET_DATA",
    "NUVO_SCHWAB_VIX_SYMBOL": "$VIX",
    "NUVO_SCREEN_SAMPLES": "1500",
    "NUVO_DECISION_SAMPLES": "8000",
    "NUVO_REFINE_TOP": "8",
    "NUVO_AI_MODEL": "@cf/openai/gpt-oss-120b",
    "NUVO_MARKET_VERSION_ID": "3e8c51cf-afb0-4b9f-a927-dcaea11b6627",
    "TELEGRAM_BOT_USERNAME": "nuvovsim_bot",
    "PUBLIC_ORIGIN": "https://nuvo-vsim-v5-shadow.yulgutierrez.workers.dev",
    "SCHWAB_CALLBACK_URL": "https://nuvo-vsim-v5-shadow.yulgutierrez.workers.dev/api/integrations/schwab/callback",
    "ACCESS_TEAM_DOMAIN": "yulgutierrez",
    "ACCESS_AUD": "9ff9966020d5438ee91a675d8ab2edc27860f1778c85c5f7f6503fd3ef00b679",
    "MCP_ACCESS_AUD": "dc81ee7c6b88272159b7c985deaea3ecd8712b0a21f518cddbb585d6e1950b35"
  }
}
